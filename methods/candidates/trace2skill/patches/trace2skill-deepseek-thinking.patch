+from src.react_agent.models import OpenAIClient
+
+
+def test_deepseek_default_explicitly_disables_thinking():
+    client = OpenAIClient(
+        model="deepseek-v4-flash",
+        api_key="fixture-key",
+        use_cache=False,
+    )
+
+    assert client.generation_config == {
+        "extra_body": {"thinking": {"type": "disabled"}}
+    }
+
+
+def test_explicit_generation_config_takes_precedence():
+    configured = {"temperature": 0.25}
+    client = OpenAIClient(
+        model="deepseek-v4-flash",
+        api_key="fixture-key",
+        use_cache=False,
+        generation_config=configured,
+    )
+
+    assert client.generation_config == configured
