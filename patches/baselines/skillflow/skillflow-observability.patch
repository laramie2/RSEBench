+def run_patch_operation_with_history(
+    operation: Callable[[], Any],
+    *,
+    history_path: Path,
+    base_entry: dict[str, Any],
+    success_entry: Callable[[Any], dict[str, Any]] | None = None,
+    utc_now: Callable[[], datetime] | None = None,
+    monotonic: Callable[[], float] | None = None,
+) -> Any:
+    """Run one patch operation and append timing evidence on every exit path."""
+
+    now = utc_now or (lambda: datetime.now(UTC))
+    clock = monotonic or time.monotonic
+    started_at = now()
+    started_monotonic = clock()
+    try:
+        result = operation()
+    except BaseException as exc:
+        ended_at = now()
+        duration_seconds = max(0.0, clock() - started_monotonic)
+        append_patch_history(
+            history_path,
+            {
+                **base_entry,
+                "started_at": started_at.isoformat(),
+                "ended_at": ended_at.isoformat(),
+                "duration_seconds": duration_seconds,
+                "status": "failed",
+                "error_type": type(exc).__name__,
+            },
+        )
+        raise
+    ended_at = now()
+    duration_seconds = max(0.0, clock() - started_monotonic)
+    append_patch_history(
+        history_path,
+        {
+            **base_entry,
+            **(success_entry(result) if success_entry is not None else {}),
+            "started_at": started_at.isoformat(),
+            "ended_at": ended_at.isoformat(),
+            "duration_seconds": duration_seconds,
+            "status": "applied",
+            "error_type": None,
+        },
+    )
+    return result
+
