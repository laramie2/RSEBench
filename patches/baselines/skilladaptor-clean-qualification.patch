@@ -0,0 +1,18 @@
+"""Append-only audit events for per-episode skill retrieval."""
+
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+from typing import Any, Dict
+
+
+def append_retrieval_event(payload: Dict[str, Any]) -> None:
+    path_text = os.environ.get("RSEBENCH_SKILL_RETRIEVAL_AUDIT", "").strip()
+    if not path_text:
+        return
+    path = Path(path_text)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open("a", encoding="utf-8") as stream:
+        stream.write(json.dumps(payload, ensure_ascii=False, sort_keys=True) + "\n")
