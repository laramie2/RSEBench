     assert target_calls.calls[0]["model"] == "target-model"
 
 
+def test_configure_disables_provider_thinking_for_tool_calls(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    target_calls = _CompletionRecorder()
+    monkeypatch.setattr(backend, "_get_client", lambda role: _Client(target_calls))
+    model.set_target_backend("openai_compatible")
+
+    model.configure_openai_compatible(thinking="disabled")
+    model.chat_target_messages(
+        [{"role": "user", "content": "Call the tool."}],
+        tools=[
+            {
+                "type": "function",
+                "function": {
+                    "name": "echo",
+                    "description": "Echo text.",
+                    "parameters": {"type": "object", "properties": {}},
+                },
+            }
+        ],
+        tool_choice="required",
+        retries=1,
+    )
+
+    assert target_calls.calls[0]["extra_body"] == {
+        "thinking": {"type": "disabled"}
+    }
+
+
