+import json
+
+import pytest
+
+from skillopt.envs.docvqa.dataloader import DocVQADataLoader
+from skillopt.envs.docvqa.rollout import _raise_on_systemic_failure
+
+
+def test_docvqa_loader_reads_bridge_json_split(tmp_path):
+    split = tmp_path / "train"
+    split.mkdir()
+    (split / "items.json").write_text(
+        json.dumps(
+            [
+                {
+                    "id": "d1",
+                    "question": "Question?",
+                    "answers": ["42"],
+                    "image_path": "/tmp/doc.png",
+                    "task_type": "figure",
+                }
+            ]
+        ),
+        encoding="utf-8",
+    )
+
+    items = DocVQADataLoader().load_split_items(str(split))
+
+    assert items[0]["id"] == "d1"
+    assert items[0]["answers"] == ["42"]
+    assert items[0]["image_path"] == "/tmp/doc.png"
+
+
+def test_docvqa_systemic_provider_failure_is_not_reported_as_zero_score():
+    rows = [
+        {
+            "id": "d1",
+            "hard": 0,
+            "agent_ok": False,
+            "fail_reason": "error: provider rejects image_url",
+        }
+    ]
+
+    with pytest.raises(RuntimeError, match="provider rejects image_url"):
+        _raise_on_systemic_failure(rows)
