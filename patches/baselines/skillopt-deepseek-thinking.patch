+from pathlib import Path
+
+from skillopt.envs.officeqa.tool_runtime import resolve_candidate_files
+
+
+def test_candidate_files_preserve_ranked_source_order(tmp_path: Path):
+    nested = tmp_path / "nested"
+    nested.mkdir()
+    for name in ("gold.txt", "decoy-b.txt", "decoy-a.txt"):
+        (nested / name).write_text(name, encoding="utf-8")
+
+    resolved = resolve_candidate_files(
+        ["decoy-a.txt", "decoy-b.txt", "gold.txt"], [str(tmp_path)]
+    )
+
+    assert [Path(path).name for path in resolved] == [
+        "decoy-a.txt",
+        "decoy-b.txt",
+        "gold.txt",
+    ]
