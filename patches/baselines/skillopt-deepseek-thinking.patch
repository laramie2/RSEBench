diff --git a/tests/test_spreadsheet_codegen_backend.py b/tests/test_spreadsheet_codegen_backend.py
new file mode 100644
index 0000000..a772ad5
--- /dev/null
+++ b/tests/test_spreadsheet_codegen_backend.py
@@ -0,0 +1,27 @@
+from types import SimpleNamespace
+
+from skillopt.envs.spreadsheetbench import codegen_agent
+
+
+def test_codegen_chat_uses_runtime_target_backend(monkeypatch):
+    captured = {}
+
+    def fake_chat_target_messages(**kwargs):
+        captured.update(kwargs)
+        return SimpleNamespace(content="```python\nprint('ok')\n```"), {}
+
+    monkeypatch.setattr(
+        codegen_agent, "chat_target_messages", fake_chat_target_messages
+    )
+
+    text = codegen_agent._chat_call(
+        [{"role": "user", "content": "write code"}],
+        max_output_tokens=123,
+        llm_timeout=9,
+    )
+
+    assert "print('ok')" in text
+    assert captured["stage"] == "rollout"
+    assert captured["max_completion_tokens"] == 123
+    assert captured["timeout"] == 9
+    assert captured["return_message"] is True
