+"""DAPO split-directory dataloader."""
+from __future__ import annotations
+
+import json
+
+from skillopt.datasets.base import SplitDataLoader
+
+
+class DAPODataLoader(SplitDataLoader):
+    """Load normalized DAPO items from JSON/JSONL split files."""
+
+    def load_raw_items(self, data_path: str) -> list[dict]:
+        with open(data_path, encoding="utf-8") as handle:
+            content = handle.read().strip()
+        if not content:
+            return []
+        try:
+            parsed = json.loads(content)
+        except json.JSONDecodeError:
+            parsed = None
+        if isinstance(parsed, list):
+            return parsed
+        if isinstance(parsed, dict):
+            return list(parsed.get("data") or parsed.values())
+        return [json.loads(line) for line in content.splitlines() if line.strip()]
+
+    def get_task_types(self) -> list[str]:
+        values = {
+            str(item.get("task_type") or "MATH")
+            for item in self.train_items + self.val_items + self.test_items
+        }
+        return sorted(values)
