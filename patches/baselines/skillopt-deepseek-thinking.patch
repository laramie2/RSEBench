diff --git a/skillopt/envs/dapo/rollout.py b/skillopt/envs/dapo/rollout.py
new file mode 100644
index 0000000..3efeb05
--- /dev/null
+++ b/skillopt/envs/dapo/rollout.py
@@ -0,0 +1,184 @@
+"""DeepSeek/API rollout for numeric exact-answer DAPO tasks."""
+from __future__ import annotations
+
+import json
+import os
+from collections import Counter
+from concurrent.futures import ThreadPoolExecutor, as_completed
+
+from skillopt.envs.dapo.evaluator import evaluate
+from skillopt.model import chat_target
+from skillopt.prompts import load_prompt
+
+
+def _build_system(skill_content: str) -> str:
+    skill_section = f"## Skill\n{skill_content.strip()}\n\n" if skill_content.strip() else ""
+    return load_prompt("rollout_system", env="dapo").format(skill_section=skill_section)
+
+
+def _build_user(
+    item: dict,
+    *,
+    diagnostic_mode: bool = False,
+    diagnostic_instruction: str = "",
+    diagnostic_trace_context: str = "",
+) -> str:
+    parts = [f"## Problem\n{item['question']}"]
+    if diagnostic_trace_context.strip():
+        parts.append(f"## Previous Trace Snapshot\n{diagnostic_trace_context.strip()}")
+    if diagnostic_mode and diagnostic_instruction.strip():
+        parts.append(f"## Training Readout\n{diagnostic_instruction.strip()}")
+    return "\n\n".join(parts)
+
+
+def process_one(
+    item: dict,
+    out_root: str,
+    skill_content: str,
+    *,
+    max_turns: int = 1,
+    exec_timeout: int = 180,
+    max_completion_tokens: int = 4096,
+    diagnostic_mode: bool = False,
+    diagnostic_instruction: str = "",
+    diagnostic_trace_context: str = "",
+) -> dict:
+    item_id = str(item["id"])
+    ground_truth = str(item.get("ground_truth", ""))
+    result = {
+        "id": item_id,
+        "question": item["question"],
+        "task_type": str(item.get("task_type") or "MATH"),
+        "hard": 0,
+        "soft": 0.0,
+        "predicted_answer": "",
+        "ground_truth": ground_truth,
+        "response": "",
+        "fail_reason": "",
+        "agent_ok": False,
+        "n_turns": 0,
+    }
+    try:
+        pred_dir = os.path.join(out_root, "predictions", item_id)
+        os.makedirs(pred_dir, exist_ok=True)
+        system = _build_system(skill_content)
+        user = _build_user(
+            item,
+            diagnostic_mode=diagnostic_mode,
+            diagnostic_instruction=diagnostic_instruction,
+            diagnostic_trace_context=diagnostic_trace_context,
+        )
+        conversation: list[dict] = []
+        response = ""
+        for turn in range(max_turns):
+            turn_user = user if turn == 0 else (
+                f"{user}\n\n## Previous Attempt\n{response}\n\n"
+                "Check the derivation and arithmetic, then return one corrected final answer."
+            )
+            response, _ = chat_target(
+                system=system,
+                user=turn_user,
+                max_completion_tokens=max_completion_tokens,
+                retries=5,
+                stage="rollout",
+                timeout=exec_timeout,
+            )
+            conversation.append({"type": "message", "turn": turn + 1, "content": response})
+            if "<answer>" in response.lower():
+                break
+        scored = evaluate(response, ground_truth)
+        result.update(
+            response=response,
+            agent_ok=True,
+            n_turns=len(conversation),
+            hard=int(scored["em"]),
+            soft=float(scored["em"]),
+            predicted_answer=scored["predicted_answer"],
+        )
+        if not result["hard"]:
+            result["fail_reason"] = (
+                f"exact=0: predicted {scored['predicted_answer']!r} "
+                f"but expected {ground_truth!r}"
+            )
+        conversation.append(
+            {
+                "role": "system",
+                "content": (
+                    "[EVALUATION RESULT]\n"
+                    f"Question: {item['question']}\n"
+                    f"Predicted answer: {scored['predicted_answer']!r}\n"
+                    f"Ground truth: {ground_truth!r}\n"
+                    f"Exact Match: {scored['em']}"
+                ),
+            }
+        )
+        with open(os.path.join(pred_dir, "target_system_prompt.txt"), "w", encoding="utf-8") as handle:
+            handle.write(system)
+        with open(os.path.join(pred_dir, "target_user_prompt.txt"), "w", encoding="utf-8") as handle:
+            handle.write(user)
+        with open(os.path.join(pred_dir, "conversation.json"), "w", encoding="utf-8") as handle:
+            json.dump(conversation, handle, ensure_ascii=False, indent=2)
+    except Exception as exc:  # noqa: BLE001
+        result["fail_reason"] = f"error: {type(exc).__name__}: {exc}"
+    return result
+
+
+def _raise_on_systemic_failure(results: list[dict]) -> None:
+    if not results or not all(row.get("agent_ok") is False for row in results):
+        return
+    reason, count = Counter(str(row.get("fail_reason")) for row in results).most_common(1)[0]
+    raise RuntimeError(f"DAPO rollout failed for all {len(results)} items ({count}x): {reason}")
+
+
+def run_batch(
+    items: list[dict],
+    out_root: str,
+    skill_content: str,
+    *,
+    max_turns: int = 1,
+    exec_timeout: int = 180,
+    workers: int = 32,
+    max_completion_tokens: int = 4096,
+    diagnostic_mode: bool = False,
+    diagnostic_instruction: str = "",
+    diagnostic_trace_context_by_id: dict[str, str] | None = None,
+) -> list[dict]:
+    os.makedirs(out_root, exist_ok=True)
+    results_path = os.path.join(out_root, "results.jsonl")
+    existing: list[dict] = []
+    if os.path.isfile(results_path):
+        with open(results_path, encoding="utf-8") as handle:
+            existing = [json.loads(line) for line in handle if line.strip()]
+    done = {str(row["id"]) for row in existing}
+    pending = [item for item in items if str(item["id"]) not in done]
+    results = list(existing)
+
+    def _call(item: dict) -> dict:
+        return process_one(
+            item,
+            out_root,
+            skill_content,
+            max_turns=max_turns,
+            exec_timeout=exec_timeout,
+            max_completion_tokens=max_completion_tokens,
+            diagnostic_mode=diagnostic_mode,
+            diagnostic_instruction=diagnostic_instruction,
+            diagnostic_trace_context=(diagnostic_trace_context_by_id or {}).get(str(item["id"]), ""),
+        )
+
+    with open(results_path, "a", encoding="utf-8") as handle:
+        with ThreadPoolExecutor(max_workers=workers) as executor:
+            futures = {executor.submit(_call, item): item for item in pending}
+            for completed, future in enumerate(as_completed(futures), start=len(existing) + 1):
+                row = future.result()
+                results.append(row)
+                handle.write(json.dumps(row, ensure_ascii=False) + "\n")
+                handle.flush()
+                correct = sum(int(result.get("hard", 0)) for result in results)
+                print(
+                    f"    [rollout] {completed}/{len(items)} "
+                    f"(acc={correct / completed:.3f}) id={row['id']} hard={row['hard']}",
+                    flush=True,
+                )
+    _raise_on_systemic_failure(results)
+    return results
