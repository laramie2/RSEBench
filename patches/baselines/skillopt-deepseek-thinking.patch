+++ b/tests/test_officeqa_failures.py
@@ -0,0 +1,65 @@
+import pytest
+from types import SimpleNamespace
+
+from skillopt.envs.officeqa import rollout
+from skillopt.envs.officeqa.rollout import _raise_on_systemic_failure
+
+
+def test_officeqa_all_systemic_failures_abort_batch():
+    rows = [
+        {"id": "a", "failure_category": "missing_oracle_page"},
+        {"id": "b", "failure_category": "provider_failure"},
+    ]
+
+    with pytest.raises(RuntimeError, match="systemic"):
+        _raise_on_systemic_failure(rows)
+
+
+def test_officeqa_ordinary_incorrect_answers_do_not_abort_batch():
+    rows = [
+        {"id": "a", "failure_category": "incorrect_answer"},
+        {"id": "b", "failure_category": "provider_failure"},
+    ]
+
+    _raise_on_systemic_failure(rows)
+
+
+def test_unstructured_response_gets_recovery_round_instead_of_early_stop(
+    tmp_path, monkeypatch
+):
+    responses = iter(["I need to calculate this first.", "<answer>42</answer>"])
+    calls = []
+
+    def fake_chat_target_messages(**kwargs):
+        calls.append(kwargs["messages"])
+        return SimpleNamespace(
+            content=next(responses), tool_calls=[], metadata={}
+        ), {}
+
+    monkeypatch.setattr(rollout, "chat_target_messages", fake_chat_target_messages)
+    monkeypatch.setattr(rollout, "is_target_exec_backend", lambda: False)
+    monkeypatch.setattr(rollout, "resolve_docs_roots", lambda _: [str(tmp_path)])
+    monkeypatch.setattr(rollout, "resolve_candidate_files", lambda *_: [])
+    monkeypatch.setattr(
+        rollout,
+        "build_oracle_parsed_pages_context",
+        lambda *_args, **_kwargs: "oracle evidence",
+    )
+
+    result = rollout.process_one(
+        {
+            "id": "q1",
+            "question": "What is the value?",
+            "ground_truth": "42",
+            "source_files": ["report.txt"],
+            "source_docs": ["https://example.test?page=1"],
+        },
+        str(tmp_path / "out"),
+        "Return an answer.",
+        max_tool_turns=2,
+        data_dirs=[str(tmp_path)],
+    )
+
+    assert len(calls) == 2
+    assert result["hard"] == 1
+    assert result["failure_category"] == "correct"
