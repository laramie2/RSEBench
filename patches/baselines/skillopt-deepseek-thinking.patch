index 0000000..1716cde
--- /dev/null
+++ b/skillopt/envs/dapo/evaluator.py
@@ -0,0 +1,58 @@
+"""Deterministic exact-answer evaluator for the numeric DAPO pilot subset."""
+from __future__ import annotations
+
+import re
+
+
+def _last_boxed(text: str) -> str:
+    starts = list(re.finditer(r"\\boxed\s*\{", text))
+    if not starts:
+        return ""
+    start = starts[-1].end()
+    depth = 1
+    for index in range(start, len(text)):
+        if text[index] == "{":
+            depth += 1
+        elif text[index] == "}":
+            depth -= 1
+            if depth == 0:
+                return text[start:index].strip()
+    return ""
+
+
+def extract_answer(text: str) -> str:
+    tagged = re.findall(r"<answer>(.*?)</answer>", text, re.DOTALL | re.IGNORECASE)
+    if tagged:
+        return tagged[-1].strip()
+    boxed = _last_boxed(text)
+    if boxed:
+        return boxed
+    labeled = re.findall(r"(?:^|\n)\s*Answer\s*:\s*(.+?)\s*$", text, re.IGNORECASE)
+    if labeled:
+        return labeled[-1].strip()
+    lines = [line.strip() for line in text.splitlines() if line.strip()]
+    return lines[-1] if lines else text.strip()
+
+
+def normalize_answer(text: str) -> str:
+    value = str(text).strip()
+    value = re.sub(r"^\$|\$$", "", value)
+    value = value.replace("\\,", "").replace(",", "")
+    value = value.replace("\\!", "").replace(" ", "")
+    value = value.rstrip(".）):;")
+    if re.fullmatch(r"[+-]?\d+\.0+", value):
+        value = value.split(".", 1)[0]
+    return value
+
+
+def evaluate(prediction_text: str, ground_truth: str) -> dict:
+    predicted = extract_answer(prediction_text)
+    correct = normalize_answer(predicted) == normalize_answer(ground_truth)
+    score = float(correct)
+    return {
+        "em": score,
+        "f1": score,
+        "sub_em": score,
+        "predicted_answer": predicted,
+        "ground_truth": str(ground_truth),
+    }
