+def _parse_thinking(value: Any) -> str | None:
+    if value is None:
+        return None
+    raw = str(value).strip().lower()
+    if not raw:
+        return None
+    if raw not in {"enabled", "disabled"}:
+        raise ValueError("thinking must be 'enabled', 'disabled', or empty")
+    return raw
+
