+def test_oracle_context_finds_jsons_under_explicit_parsed_root(tmp_path: Path):
+    parsed = tmp_path / "parsed"
+    json_path = parsed / "jsons/treasury_bulletin_1954_02.json"
+    json_path.parent.mkdir(parents=True)
+    json_path.write_text(
+        json.dumps(
+            {
+                "document": {
+                    "elements": [
+                        {
+                            "content": "Treasury evidence value: 42",
+                            "bbox": [{"page_id": 7}],
+                        }
+                    ]
+                }
+            }
+        ),
+        encoding="utf-8",
+    )
+
+    context = build_oracle_parsed_pages_context(
+        "treasury_bulletin_1954_02.txt",
+        "https://example.test/bulletin?page=7",
+        [str(parsed)],
+    )
+
