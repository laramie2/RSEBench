+def _parse_tool_arguments(raw: str) -> dict:
+    """Parse OpenAI-compatible tool arguments with bounded DeepSeek repair."""
+    text = raw or "{}"
+    try:
+        parsed = json.loads(text)
+    except json.JSONDecodeError:
+        # DeepSeek occasionally emits literal newlines or tabs inside a JSON
+        # string. Python's non-strict decoder repairs only those control
+        # characters; structural JSON errors still raise.
+        parsed = json.loads(text, strict=False)
+    if not isinstance(parsed, dict):
+        raise ValueError("tool arguments must be a JSON object")
+    return parsed
+
