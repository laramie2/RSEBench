+def apply_goal_context(observation: str, overlay: Dict[str, Any]) -> str:
+    """Append only the frozen N1 context; never alter the official goal."""
+    if overlay.get('stage') != 'N1':
+        return observation
+    clean_goal = str(overlay.get('clean_goal') or '')
+    noisy_goal = str(overlay.get('noisy_goal') or '')
+    suffix = noisy_goal[len(clean_goal):] if clean_goal and noisy_goal.startswith(clean_goal) else noisy_goal
+    return observation + suffix if suffix.strip() else observation
+
+
+def apply_product_overlay(
+    products: List[Dict[str, Any]],
+    product_item_dict: Dict[str, Dict[str, Any]],
+    overlay: Dict[str, Any],
+) -> List[Dict[str, Any]]:
+    """Return a ranked view from frozen product IDs without mutating catalog."""
+    if overlay.get('stage') != 'N2':
+        return list(products)
+    desired = [str(value) for value in overlay.get('output_product_ids') or []]
+    ordered: List[Dict[str, Any]] = []
+    seen: set[str] = set()
+    for product_id in desired:
+        product = product_item_dict.get(product_id)
+        if product is not None and product_id not in seen:
+            ordered.append(product)
+            seen.add(product_id)
+    for product in products:
+        product_id = str(product.get('asin') or '')
+        if product_id not in seen:
+            ordered.append(product)
+            seen.add(product_id)
+    return ordered[:max(len(products), len(desired))]
+
