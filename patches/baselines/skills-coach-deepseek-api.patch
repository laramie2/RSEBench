diff --git a/tests/test_deepseek_client.py b/tests/test_deepseek_client.py
new file mode 100644
index 0000000..5c5c06a
--- /dev/null
+++ b/tests/test_deepseek_client.py
@@ -0,0 +1,71 @@
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+
+SKILLS_COACH_ROOT = Path(__file__).parents[1] / "skills-coach"
+
+
+def test_anthropic_compat_routes_to_locked_deepseek(monkeypatch):
+    from rsebench.adapters import skills_coach as deepseek_client
+
+    calls = []
+
+    class Completions:
+        def create(self, **kwargs):
+            calls.append(kwargs)
+            message = SimpleNamespace(content="ok")
+            return SimpleNamespace(choices=[SimpleNamespace(message=message)])
+
+    fake = SimpleNamespace(chat=SimpleNamespace(completions=Completions()))
+    monkeypatch.setattr(deepseek_client, "OpenAI", lambda **kwargs: fake)
+
+    client = deepseek_client.DeepSeekAnthropicCompat(api_key="fixture-key")
+    response = client.messages.create(
+        model="claude-sonnet-4-6",
+        max_tokens=32,
+        messages=[{"role": "user", "content": "hello"}],
+    )
+
+    assert response.content[0].text == "ok"
+    assert calls[0]["model"] == "deepseek-v4-flash"
+    assert calls[0]["extra_body"] == {"thinking": {"type": "disabled"}}
+
+
+def test_client_requires_deepseek_key(monkeypatch):
+    from rsebench.adapters import skills_coach as deepseek_client
+
+    monkeypatch.delenv("DEEPSEEK_API_KEY", raising=False)
+
+    try:
+        deepseek_client.DeepSeekAnthropicCompat()
+    except RuntimeError as exc:
+        assert "DEEPSEEK_API_KEY" in str(exc)
+    else:
+        raise AssertionError("missing key was accepted")
+
+
+def test_active_pipeline_has_no_anthropic_or_claude_cli_model_calls():
+    active = [
+        SKILLS_COACH_ROOT / "api_checker.py",
+        SKILLS_COACH_ROOT
+        / "subskills"
+        / "optimize-agent"
+        / "training_free_grpo_optimizer.py",
+        SKILLS_COACH_ROOT / "subskills" / "optimize-agent" / "auto_fixer.py",
+        SKILLS_COACH_ROOT / "subskills" / "optimize-agent" / "command_optimizer.py",
+        SKILLS_COACH_ROOT / "subskills" / "evaluate-agent" / "evaluator.py",
+    ]
+
+    for path in active:
+        source = path.read_text(encoding="utf-8")
+        assert "anthropic.Anthropic" not in source, path
+        assert "['claude'," not in source, path
+
+
+def test_command_optimizer_is_valid_python():
+    path = (
+        SKILLS_COACH_ROOT / "subskills" / "optimize-agent" / "command_optimizer.py"
+    )
+
+    compile(path.read_text(encoding="utf-8"), str(path), "exec")

