{
  "$defs": {
    "EvidenceReference": {
      "additionalProperties": false,
      "description": "A content-addressed provenance record supporting a release decision.",
      "properties": {
        "kind": {
          "default": "manifest",
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "PatchIdentity": {
      "additionalProperties": false,
      "description": "One ordered, content-addressed integration patch.",
      "properties": {
        "purpose": {
          "enum": [
            "provider",
            "evidence",
            "compatibility",
            "robustness"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256",
        "purpose"
      ],
      "title": "PatchIdentity",
      "type": "object"
    },
    "ValidationProvider": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "minLength": 1,
          "title": "Family",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "temperature": {
          "default": 0.0,
          "title": "Temperature",
          "type": "number"
        },
        "thinking": {
          "const": "disabled",
          "default": "disabled",
          "title": "Thinking",
          "type": "string"
        }
      },
      "required": [
        "family",
        "model"
      ],
      "title": "ValidationProvider",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "arm": {
      "const": "noisy",
      "default": "noisy",
      "title": "Arm",
      "type": "string"
    },
    "baseline_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Baseline Fingerprint",
      "type": "string"
    },
    "cell_id": {
      "minLength": 1,
      "title": "Cell Id",
      "type": "string"
    },
    "clean_evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      },
      "title": "Clean Evidence",
      "type": "array"
    },
    "clean_evidence_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Clean Evidence Hash",
      "type": "string"
    },
    "dataset_release_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dataset Release Hash",
      "type": "string"
    },
    "dataset_release_id": {
      "minLength": 1,
      "title": "Dataset Release Id",
      "type": "string"
    },
    "domain": {
      "enum": [
        "spreadsheet",
        "document",
        "interactive",
        "skill"
      ],
      "title": "Domain",
      "type": "string"
    },
    "form": {
      "enum": [
        "static",
        "runtime"
      ],
      "title": "Form",
      "type": "string"
    },
    "identity_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Identity Hash",
      "type": "string"
    },
    "matrix_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Matrix Hash",
      "type": "string"
    },
    "matrix_release_id": {
      "minLength": 1,
      "title": "Matrix Release Id",
      "type": "string"
    },
    "method": {
      "minLength": 1,
      "title": "Method",
      "type": "string"
    },
    "method_release_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Method Release Hash",
      "type": "string"
    },
    "method_release_id": {
      "minLength": 1,
      "title": "Method Release Id",
      "type": "string"
    },
    "noise_seed": {
      "title": "Noise Seed",
      "type": "integer"
    },
    "operator": {
      "minLength": 1,
      "title": "Operator",
      "type": "string"
    },
    "patch_series": {
      "items": {
        "$ref": "#/$defs/PatchIdentity"
      },
      "title": "Patch Series",
      "type": "array"
    },
    "plugin_entrypoint": {
      "minLength": 1,
      "title": "Plugin Entrypoint",
      "type": "string"
    },
    "plugin_version": {
      "minLength": 1,
      "title": "Plugin Version",
      "type": "string"
    },
    "provider": {
      "$ref": "#/$defs/ValidationProvider"
    },
    "runtime": {
      "additionalProperties": true,
      "title": "Runtime",
      "type": "object"
    },
    "schema_version": {
      "const": "rsebench.validation-cell.v1",
      "default": "rsebench.validation-cell.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_mode": {
      "enum": [
        "read_only",
        "copy_on_run"
      ],
      "title": "Source Mode",
      "type": "string"
    },
    "stage": {
      "enum": [
        "N1",
        "N2",
        "N3",
        "N4"
      ],
      "title": "Stage",
      "type": "string"
    },
    "upstream_revision": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Upstream Revision",
      "type": "string"
    }
  },
  "required": [
    "matrix_release_id",
    "matrix_hash",
    "cell_id",
    "identity_hash",
    "domain",
    "stage",
    "form",
    "operator",
    "plugin_entrypoint",
    "plugin_version",
    "dataset_release_id",
    "dataset_release_hash",
    "method",
    "method_release_id",
    "method_release_hash",
    "upstream_revision",
    "patch_series",
    "baseline_fingerprint",
    "clean_evidence",
    "clean_evidence_hash",
    "provider",
    "runtime",
    "noise_seed",
    "source_mode"
  ],
  "title": "ValidationCell",
  "type": "object"
}
